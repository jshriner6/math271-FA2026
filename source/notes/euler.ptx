            <exercise workspace="4in" >
            <title>Polar Coordinate Representation</title>
                <statement>
                    <p>
                        In standard coordinates, we identify a complex number <m>z</m> uniquely by its real and imaginary parts.
                        <md>
                            z= a + bi , \,\,\,\, z = (a,b)
                        </md>
                        
                        This is not the only way to identify a complex number.
                    </p>
                </statement>
            </exercise>
    
    </page>
    <page>

            <exercise>
                <title>Example: Polar Coordinate Representation</title>
                <introduction>
                    <p>
                        
                    </p>
                </introduction>
                <task workspace="2in">
                    <statement>
                        <p>
                            Let <m>z=1-i</m>.
                        </p>
                    </statement>
                </task>

                <task workspace="2in">
                    <statement>
                        <p>
                            Let <m>z= - 1+i</m>.
                        </p>
                    </statement>
                </task>
                
                
            </exercise>
        </page>

        <page>
            <exercise>
            <title>Euler's Formula</title>
                <statement>
                    <p>
                        Let <m>f(\theta) = e^{-i\theta}(\cos(\theta) + i\sin(\theta))</m>.
                    </p>
                </statement>

                
            </exercise>
            
