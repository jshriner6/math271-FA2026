    <page>

            <exercise workspace="2in">
                <title>Example: Integrals Over Surfaces</title>
                <statement>
                    <p>
                        Compute <m>\iiint_S 1 \quad dV</m>, where <m>S</m> is the surface below 
                        <m>z=6-x</m>, above <m>z = -\sqrt{4x^2 +4y^2}</m>, and inside <m>x^2 + y^2=3</m> with <m>x \leq 0</m>.
                        
                    </p>
                </statement>
              
                
