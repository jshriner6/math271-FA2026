        <page>

            <exercise>
                <title>Examples: Improper Integrals</title>
                <introduction>
                    <p>
                        We'll compute a couple of examples by hand to add experience to our intuition, and focus on 
                        important applications of improper integrals next time.
                    </p>
                </introduction>
                <task workspace="5in">
                    <statement>
                        <p>
                         <m> \displaystyle     \int_1^{\infty} \frac{1}{x} \quad dx </m>  
                        </p>
                    </statement>
                </task>
                
                <task workspace="5in">
                    <statement>
                        <p>
                            <m>
                               \displaystyle \int_{-\infty}^{\infty} \frac{1}{1+x^2} \quad dx
                            </m>
                            
                        </p>
                    </statement>
                </task>

                <task workspace="1in">
