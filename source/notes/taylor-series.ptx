<page>

            <exercise>
                <title>Taylor Series: Common Functions</title>
                <introduction>
                    <p>
                     Let's consider the Maclaurin series (Taylor series centered at <m>0</m>) for each function below.
                    </p>
                </introduction>
                <task workspace="4in">
                    <statement>
                        <p>
                            <m>\displaystyle f(x) = e^x</m>
                        </p>
                    </statement>
                </task>
                <task workspace="4in">
                    <statement>
                        <p>
                            <m>\displaystyle g(x) = \sin(x)</m>
                        </p>
                    </statement>
                </task>
                <task workspace="4in">
                    <statement>
                        <p>
                            <m>\displaystyle h(x) = \frac{1}{1-x}</m>
                        </p>
                    </statement>
                </task>
                
            </exercise>

            
    </page>

    <page>
        <exercise>
            <title>New Series from Old: Substitution</title>
            <introduction>
                <p>
                    We'll extend this more next time, but you can generate many new Taylor series by using existing Taylor series 
                    (and not computing from scratch).
                </p>
               
            </introduction>
            <task workspace="4in">
                <statement>
                    <p>
                        <m>\displaystyle f(x) = e^{-x}</m>
                    </p>
                </statement>
            </task>
            <task workspace="4in">
                <statement>
                    <p>
                        <m>\displaystyle g(x) =\frac{1}{1+x}</m>
                    </p>
                </statement>
            </task>
            
        </exercise>
    </page>

   

       
