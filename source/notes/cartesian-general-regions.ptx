<page>
            <exercise workspace="2in">
                <title>Example: General Regions</title>
                <statement>
                    <p>
                        Let <m>D</m> be the region below <m>y=1</m> and above <m>y=x</m> for positive <m>x</m>. We could integrate 
                        over this region in either order:
                    </p>
                </statement>
            </exercise>
    
    </page>
    <page>

            <exercise workspace="2in">
                <title>Practice</title>
                <statement>
                    <p>
                        Compute <m>\displaystyle \iint_D 1 + 2xy \quad dA</m> in both orders, where <m>D</m> is the region
                        below <m>y=x</m> and above <m>y=x^2</m>.
                        
                    </p>
                </statement>
              
                
