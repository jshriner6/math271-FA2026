    <page>

            <exercise workspace="6in">
                <title>Approximating Integrals</title>
                <introduction>
                    <p>
                        We've seen that computing integrals can be a challenge, and we've already seen some numerical 
                        techniques for approximating integrals. Series representations give us yet another approach:
                    </p>
                </introduction>
                <task>
                    <statement>
                        <p>
                            Compute <m>\displaystyle \int e^{-x^2} \quad dx</m>.
                        </p>
                    </statement>
                </task>

                <task>
                    <statement>
                        <p>
                            Estimate <m>\displaystyle \int_{-2}^2 e^{-x^2} \quad dx</m>.
                        </p>
                    </statement>
                </task>
              
                
            </exercise>
