<?xml version="1.0" encoding="UTF-8"?>

<!-- When creating a new activity, make a copy of this file with appropriate name -->
<worksheet xml:id="lab11">
  <title>Lab 11</title>

  <!-- Optional introduction -->
  <introduction>
    <p>
      This lab is intended to practice ideas related to linear systems. It is an opportunity
      to explore important concepts with others, explain your understanding, and ask questions. As such, these exercises should
      be thought of as a starting point for exploration, and you should feel free to ask related questions or explore related ideas
      if your interest is led somewhere else.
    </p>
    <p>
      You will be graded on effort and engagement during class time, not necessarily on completing every exercise. Guidelines
      for working together may be provided in class.
    </p>
  </introduction>
  
<page>
  <!-- Exercises start here. -->
  <exercise>
    <introduction>
      <p>
       For each matrix <m>A</m> and vector <m>\bvec</m> below, write the matrix equation <m>A\xvec = \bvec</m> as a system of
       linear equations. Then solve the system using augmented matrices and the <url href="https://www.desmos.com/matrix">Desmos matrix calculator</url> to 
       compute RREF.
      </p>
    </introduction>
    <task workspace="2in">
        <statement>
            <p>
               <md>A = 
                 \begin{bmatrix}
                    2 \amp 0 \amp 2 \\
                    4 \amp -1 \amp 6 \\
                    1  \amp 3 \amp -5
                \end{bmatrix}, \quad

                \bvec = \begin{bmatrix}
                    0 \\
                    -5  \\
                    15
                \end{bmatrix}

               </md>
               
            </p>
        </statement>
    </task>
    <task workspace="2in">
        <statement>
            <p>
               <md>A = 
                 \begin{bmatrix}
                    3\amp -1 \amp 0 \\
                    -2 \amp 0 \amp 6

                \end{bmatrix}, \quad

                \bvec = \begin{bmatrix}
                    -6 \\
                    2  
                \end{bmatrix}

               </md>
               
            </p>
        </statement>
    </task>
    <task workspace="2in">
        <statement>
            <p>
               <md>A = 
                 \begin{bmatrix}
                    1 \amp 2 \amp 0 \amp -1 \\
                   2 \amp 4 \amp -3 \amp -2 \\
                    -1  \amp -2 \amp 6 \amp 1
                \end{bmatrix}, \quad

                \bvec = \begin{bmatrix}
                    -1 \\
                    1  \\
                    5
                \end{bmatrix}

               </md>
               
            </p>
        </statement>
    </task>
    
    
</exercise>

<exercise>
    <introduction>
        <p>
            Consider the reaction
            <md>
                xH_2 + yO_2 \to zH_2O
            </md>.
            
        </p>
    </introduction>
    <task workspace="2in">
        <statement>
            <p>
             Model balancing this reaction using a linear system of equations.
            </p>
        </statement>
    </task>
    <task workspace="2in">
        <statement>
            <p>
                Find the solution space of your system. Why would you expect infinitely many solutions when balancing 
                a chemical reaction?
            </p>
        </statement>
    </task>
    <task workspace="2in">
        <statement>
            <p>
                Find the solution for which <m>x,y,z</m> are the smallest possible positive integers.
            </p>
        </statement>
    </task>
</exercise>
</page>

<page>
    <exercise>
        <introduction>
            <p>
                A set of vectors <m>\{\vvec_1, \dots , \vvec_n\}</m> is <term>linearly independent</term> if
                <md>
                    c_1 \vvec_1 + \cdots + c_n \vvec_n = \mathbf{0}
                </md>
                implies that <m>c_1 = c_2 = \cdots = c_n = 0</m>.
                
            </p>
        </introduction>
        <task workspace="2in">
            <statement>
                <p>
                    Write the above condition as a matrix equation.
                </p>
            </statement>
        </task>
        <task workspace="2in">
            <statement>
                <p>
                    Set up and solve a linear system to determine if the following sets of vectors are linearly independent.
                    <ol>
                        <li>
                            <p>
                                <m>\left\{\begin{bmatrix} 0 \\ -1 \\ 2 \end{bmatrix}, \begin{bmatrix} 3 \\ 1 \\ -1 \end{bmatrix}, \begin{bmatrix} 2 \\ 0 \\ 1 \end{bmatrix}\right\}</m>
                            </p>
                        </li>
                        <li>
                            <p>
                                <m>\left\{\begin{bmatrix} 0 \\ -1 \\ 2 \end{bmatrix}, \begin{bmatrix} 3 \\ 1 \\ -1 \end{bmatrix}, \begin{bmatrix} 3 \\ 0 \\ 1 \end{bmatrix}\right\}</m>
                            </p>
                        </li>
                    </ol>
                </p>
            </statement>
        </task>
    </exercise>
</page>


</worksheet>
