<?xml version="1.0" encoding="UTF-8"?>

<worksheet>
  <title>Homework 1 (Week 1)</title>

  <page>
    <exercise>
      <statement>
        <p>
          Give and example of a complex number in the form <m>z=re^{i \theta}</m> such that <m>\text{Re}(z) \lt 0</m> and 
          <m>\text{Im}(z) \gt 0</m>. Be sure you can visualize your answer in the complex plane to justify why it meets the 
          requirements.
        </p>
      </statement>
    </exercise>

    <exercise>
      <statement>
        <p>
          Write <m>z=e^{-i \pi/3}</m> in the form <m>a + bi</m>. Sketch this number in the complex plane, identifying the 
          coordinates <m>(r, \theta)</m> and <m>(a,b)</m>.
        </p>
      </statement>
    </exercise>

    <exercise>
      <introduction>
        <p>
          Write each <m>z</m> below in the form <m>re^{i\theta}</m>, with <m>-\pi \lt \theta \leq \pi</m>. Sketch each number 
          in the complex plane.
        </p>
      </introduction>
      <task>
        <statement>
          <p>
            <m>z = \sqrt{3} + i</m>
          </p>
        </statement>
      </task>

      <task>
        <statement>
          <p>
            <m>z = -1 - i</m>
          </p>
        </statement>
      </task>
    </exercise>

    <exercise>
      <statement>
        <p>
          Find all <m>z</m> such that <m>z\cdot \overline{z} + 4(z- \overline{z}) = 5 + 16i</m>.
        </p>
      </statement>
    </exercise>

  <exercise>
    <statement>
      <p>
        Use Euler's formula to show that
        <md>
          \cos(2\theta) = \cos^2(\theta) - \sin^2(\theta)  
        </md>
        and
        <md>
          \sin(2\theta) = 2\sin(\theta)\cos(\theta)
        </md>.
        
        
      </p>
    </statement>
  </exercise>
  </page>
</worksheet>
