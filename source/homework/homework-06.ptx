<worksheet>
  <title>Homework 6 (Weeks 10 and 11)</title>

  <page>
  

    <exercise>
        <introduction>
            <p>
           
            </p>
        </introduction>
        <task>
            <statement>
                <p>
                   Verify that the set of <m>2 \times 2</m> real matrices form a vector space over 
                   <m>\R</m>. Identify a basis of this vector space, and use it to determine the dimension of the vector space.
                </p>
                
            </statement>
        </task>
        <task>
            <statement>
                <p>
                    Are the set of <m>2 \times 2</m> real matrices a vector space over <m>\C</m>? If so, determine a basis 
                    and the dimension. If not, explain why.
                </p>
            </statement>
        </task>
        <task>
            <statement>
                <p>
                     Are the set of <m>m \times n</m> complex matrices a vector space over <m>\C</m>? If so, determine a basis 
                    and the dimension. If not, explain why.
                </p>
            </statement>
        </task>
        
    </exercise>

    <exercise>
        <introduction>
            <p>
        Let 
        <md> A = 
            \begin{bmatrix}
            1 \amp 1 \amp 1 \\
            2 \amp 2 \amp 2
            \end{bmatrix}
        </md>.


        
            </p>
        </introduction>
        <task>
            <statement>
                <p>
                   Find all solutions to <m>A\xvec = \mathbf{0}</m>. This is call the <term>null space</term> of <m>A</m>.
                </p>
            </statement>
        </task>
        <task>
            <statement>
                <p>
                    The null space of a matrix is itself a vector space (it is closed under addition and scalar multiplication).
                    Use your solution above to identify a basis for the null space of <m>A</m>.
                </p>
            </statement>
        </task>
        
    </exercise>
    <exercise>
        <introduction>
            <p>
               For each reaction below, write the balanced equation as a linear system of equations. Then determine the
               smallest positive integers that balance the reaction.
            </p>
        </introduction>
        <task>
            <statement>
                <p>
                    <m>x_1Al +x_2HCl \to x_3AlCl_3 +x_4H_2</m>
                </p>
            </statement>
        </task>

         <task>
            <statement>
                <p>
                    <m>x_1KMnO_4 +x_2MnSO_4 + x_3H_2O \to x_4MnO_2 +x_5K_2SO_4 + x_6H_2SO_4</m>
                </p>
            </statement>
        </task>
    
    </exercise>

   
     

    <exercise>
        <introduction>
            <p>
               Create a matrix in RREF for each set of criteria below, or explain why it is not possible.
            </p>
        </introduction>
        <task>
            <statement>
                <p>
                   A system of <m>6</m> equations and <m>4</m> variables with a unique solution.
                </p>
            </statement>
        </task>

        <task>
            <statement>
                <p>
                   A system of <m>4</m> equations and <m>6</m> variables with a unique solution.
                </p>
            </statement>
        </task>

        <task>
            <statement>
                <p>
                   A system of <m>4</m> equations and <m>4</m> variables for which <m>x_3</m> is the only free 
                   variable.
                </p>
            </statement>
        </task>

        <task>
            <statement>
                <p>
                   A system of <m>10</m> equations and <m>10</m> variables with exactly two solutions.
                </p>
            </statement>
        </task>
       
    </exercise>
   
