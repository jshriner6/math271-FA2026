<?xml version="1.0" encoding="UTF-8"?>

<worksheet>
  <title>Homework 7 (Weeks 12 and 13)</title>

  <page>
  

    <exercise>
        <introduction>
            <p>
           Represent each geometric transformation of <m>\R^2</m> as a matrix. Write one sentence describing your strategy.
            </p>
        </introduction>
        <task>
            <statement>
                <p>
                   Reflection over the diagonal <m>y=x</m>. Test vectors <m>\langle 3,3 \rangle</m> and <m>\langle 1, 5 \rangle</m>
                   with matrix multiplication.
                </p>
                
            </statement>
        </task>
        <task>
            <statement>
                <p>
                    Rotation counter-clockwise by <m>\pi/4</m> radians (<m>45</m> degrees).
                </p>
            </statement>
        </task>
        
    </exercise>

    <exercise>
        <introduction>
        <p>
                Let <m>\mathcal{B}_1 = \{\langle 1,0 \rangle , \langle 0,1 \rangle \}</m> and <m>\mathcal{B}_2 = \{ \langle -1,1 \rangle , \langle 0,-1 \rangle\}</m>
                be two bases of <m>\R^2</m> over <m>\R</m>.
        
            </p>
        </introduction>
        <task>
            <statement>
                <p> 
                   Write a matrix which converts vectors from basis <m>\mathcal{B}_2</m> to <m>\mathcal{B}_1</m>. 
                   Illustrate how it works using the vector <m>\langle 2,3 \rangle</m>, which is in <m>\mathcal{B}_2</m> coordinates.
                </p>
            </statement>
        </task>
        <task>
            <statement>
                <p>
                    Write a matrix which converts vectors from basis <m>\mathcal{B}_1</m> to <m>\mathcal{B}_2</m>. 
                   Explain how this matrix relates to your matrix from the previous part, 
                   and illustrate how it works using the vector <m>\langle 2,3 \rangle</m>, which is in <m>\mathcal{B}_1</m> coordinates.
                </p>
            </statement>
        </task>
        
    </exercise>
    <exercise>
        <introduction>
            <p>
               Let <m>A = \begin{bmatrix}z_1 \amp z_2 \\ z_3 \amp z_4 \end{bmatrix}</m> be a linear transformation, 
               <m>A: \C^2 \to \C^2</m>. For <m>\uvec = \langle u_1, u_2 \rangle, \vvec=\langle v_1, v_2 \rangle \in \C^2</m>, use the inner product on <m>\C^2</m> defined by the dot product:
               <md>
                \langle \uvec ,\vvec \rangle = \overline{\uvec} \cdot \vvec = \overline{u_1}v_1 + \overline{u_2}v_2
               </md>.
               
            </p>
        </introduction>
        <task>
            <statement>
                <p>
                    Compute <m>\langle A \uvec, \vvec\rangle</m>.
                </p>
            </statement>
        </task>

         <task>
            <statement>
                <p>
                    Compute <m>\langle  \uvec,A \vvec\rangle</m>.
                </p>
            </statement>
        </task>
        <task>
            <statement>
                <p>
                    If <m>A</m> is self-adjoint (that is, the inner products from the previous parts are equal for every <m>\uvec,\vvec \in \C^2</m>), show that
                    this also implies that <m>A</m> is a Hermitian matrix.
                </p>
            </statement>
        </task>


    
    </exercise>

   
     

    <exercise>
        <introduction>
            <p>
               Find the eigenvalues and eigenvectors of each linear transformation below. Be sure you can show your work using the characteristic polynomial of each transformation to find eigenvalues, as well as the linear systems used to find eigenvectors.
            </p>
        </introduction>
        <task>
            <statement>
                <p>
                    <m>
                    \displaystyle
                   \begin{bmatrix}
                    1 \amp 2 \\
                    3 \amp 2
                   \end{bmatrix}
                   </m>
                </p>
            </statement>
        </task>

         <task>
            <statement>
                <p>
                    <m>
                    \displaystyle
                   \begin{bmatrix}
                    -5 \amp 1 \\
                    4 \amp -2
                   \end{bmatrix}
                   </m>
                </p>
            </statement>
        </task>

         <task>
            <statement>
                <p>
                    <m>
                    \displaystyle
                   \begin{bmatrix}
                    3 \amp -13 \\
                    5 \amp 1
                   \end{bmatrix}
                   </m>
                </p>
            </statement>
        </task>

         <task>
            <statement>
                <p>
                    <m>
                    \displaystyle
                   \begin{bmatrix}
                    7 \amp 1 \\
                    -4 \amp 3
                   \end{bmatrix}
                   </m>
                </p>
            </statement>
        </task>
       
    </exercise>
   
    </page>


</worksheet>
