    <!-- Include sections -->
    <section xml:id="sec-course-details">
      <title>Course Details</title>

      <paragraphs>
        <title>Course Meetings</title>

        <p>
          <dl>
            <li>
              <title>Time:</title>
              <p>
                M/T/W/F, 9:00am -- 9:50am
              </p>
            </li>
            <li>
              <title>Place:</title>
              <p>
                Social Sciences Hall C 3818
              </p>
            </li>
          </dl>       
        </p>
      </paragraphs>  

      <paragraphs>
        <title>Course Instructor</title>
        <p>
          <dl>
            <li>
              <title>Instructor:</title>
              <p>
                Dr. Jeff Shriner
              </p>
            </li>
            <li>
              <title>Email:</title>
